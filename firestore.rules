rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200;
    }

    function isUserProfileImmutable(incoming, existing) {
      return incoming.uid == existing.uid &&
             incoming.email == existing.email;
    }

    function isValidAgenda(data) {
      return data.keys().hasAll(['uid', 'title', 'category', 'time']) &&
             data.uid == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.time is string && data.time.size() <= 10;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['uid', 'name', 'amount', 'type']) &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.amount is number &&
             data.type in ['debit', 'credit'];
    }

    function isValidMeal(data) {
      return data.keys().hasAll(['uid', 'name', 'calories']) &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() <= 200 &&
             data.calories is number;
    }

    function isValidWorkoutSession(data) {
      return data.keys().hasAll(['uid', 'date', 'title', 'exercises']) &&
             data.uid == request.auth.uid &&
             data.date is string && data.date.size() <= 50 &&
             data.title is string && data.title.size() <= 200 &&
             data.exercises is list;
    }

    function isValidHabit(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string;
    }

    function isValidScoreHistory(data) {
      return data.keys().hasAll(['total', 'date']) &&
             data.date is string;
    }

    function isValidCheckin(data) {
      return data.keys().hasAll(['date', 'skipped', 'wellbeingPoints']) &&
             data.date is string &&
             data.skipped is bool &&
             data.wellbeingPoints is number;
    }

    // Rules
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && isUserProfileImmutable(incoming(), existing());

      match /agenda/{itemId} {
        allow read, write: if isOwner(userId);
      }

      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }

      match /meals/{mealId} {
        allow read, write: if isOwner(userId);
      }

      match /workoutSessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      match /habits/{habitId} {
        allow read, write: if isOwner(userId);
      }

      match /scoreHistory/{historyId} {
        allow read, write: if isOwner(userId);
      }

      match /checkins/{checkinId} {
        allow read, write: if isOwner(userId);
      }

      match /recurringTemplates/{templateId} {
        allow read, write: if isOwner(userId);
      }

      match /challenges/{weekId} {
        allow read, write: if isOwner(userId);
      }

      match /focusSessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      match /workoutPlan/{planId} {
        allow read, write: if isOwner(userId);
      }

      match /dietBase/{dietId} {
        allow read, write: if isOwner(userId);
      }

      match /dietProgress/{date} {
        allow read, write: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
